<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:notatnik"
        x:Class="notatnik.MainWindow"
        Title="Notatnik"
        Width="800" Height="500"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="250, *">
        <!-- Lewa kolumna: Lista notatek -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0" Padding="10">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Zapisane notatki:" FontWeight="Bold" Margin="0,0,0,8" />
                <ListBox x:Name="NotesList" SelectionChanged="OnNoteSelected" />
            </DockPanel>
        </Border>

        <!-- Prawa kolumna: Formularz z przyciskiem zapisu na dole -->
        <Grid Grid.Column="1" RowDefinitions="Auto, Auto, Auto, *, Auto" Margin="15">
            <TextBlock Grid.Row="0" Text="Tytuł:" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBox Grid.Row="1" x:Name="TitleBox" PlaceholderText="Wpisz tytuł..." Margin="0,0,0,10" />

            <TextBlock Grid.Row="2" Text="Treść:" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBox Grid.Row="3" x:Name="ContentBox" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="Wpisz treść..." />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,10,0,0">
                <Button Content="Zapisz" Click="OnSaveClick" Padding="16,8" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
